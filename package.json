{
	"name": "qckpages",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"build:cli": "bun build --compile src/cli/index.ts --outfile dist/qckpage",
		"build:cli:linux-x64": "bun build --compile --target=bun-linux-x64 src/cli/index.ts --outfile dist/qckpage-linux-x64",
		"build:cli:linux-arm64": "bun build --compile --target=bun-linux-arm64 src/cli/index.ts --outfile dist/qckpage-linux-aarch64",
		"build:cli:darwin-x64": "bun build --compile --target=bun-darwin-x64 src/cli/index.ts --outfile dist/qckpage-darwin-x64",
		"build:cli:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 src/cli/index.ts --outfile dist/qckpage-darwin-aarch64",
		"build:cli:windows-x64": "bun build --compile --target=bun-windows-x64 src/cli/index.ts --outfile dist/qckpage-windows-x64.exe",
		"build:cli:all": "bun run build:cli && bun run build:cli:linux-x64 && bun run build:cli:linux-arm64 && bun run build:cli:darwin-x64 && bun run build:cli:darwin-arm64 && bun run build:cli:windows-x64",
		"cli": "bun src/cli/index.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^24",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@convex-dev/better-auth": "^0.12.2",
		"@mmailaender/convex-better-auth-svelte": "^0.7.4",
		"@mmailaender/convex-svelte": "^0.19.0",
		"better-auth": "1.6.11",
		"commander": "^15.0.0",
		"convex": "^1.38.0",
		"lucide-svelte": "^1.0.1",
		"picocolors": "^1.1.1",
		"razorpay": "^2.9.6",
		"tldts": "^7.4.9"
	}
}
